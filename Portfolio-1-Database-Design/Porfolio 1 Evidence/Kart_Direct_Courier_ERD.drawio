        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    CUSTOMERS ||--o{ CUSTOMER_ADDRESSES : has\n    CUSTOMERS ||--o{ ORDERS : places\n    CATEGORIES ||--o{ PRODUCTS : contains\n    ORDERS ||--|{ ORDER_ITEMS : contains\n    PRODUCTS ||--o{ ORDER_ITEMS : appears_in\n    ORDERS ||--o{ PAYMENTS : has\n    ORDERS ||--o| DELIVERIES : receives\n    CUSTOMER_ADDRESSES ||--o{ DELIVERIES : destination\n    COURIERS o|--o{ DELIVERIES : handles\n    DELIVERIES ||--o{ DELIVERY_STATUS_HISTORY : records\n\n    CUSTOMERS {\n        int customer_id PK\n        varchar first_name\n        varchar last_name\n        varchar email UK\n        varchar phone\n        timestamp created_at\n    }\n\n    CUSTOMER_ADDRESSES {\n        int address_id PK\n        int customer_id FK\n        varchar address_line\n        varchar city\n        varchar state\n        varchar postal_code\n        boolean is_default\n    }\n\n    CATEGORIES {\n        int category_id PK\n        varchar category_name UK\n    }\n\n    PRODUCTS {\n        int product_id PK\n        int category_id FK\n        varchar product_name\n        text description\n        numeric unit_price\n        int stock_quantity\n        boolean is_active\n    }\n\n    ORDERS {\n        int order_id PK\n        int customer_id FK\n        timestamp order_date\n        varchar order_status\n    }\n\n    ORDER_ITEMS {\n        int order_item_id PK\n        int order_id FK\n        int product_id FK\n        int quantity\n        numeric unit_price\n    }\n\n    PAYMENTS {\n        int payment_id PK\n        int order_id FK\n        numeric amount\n        varchar payment_method\n        varchar payment_status\n        varchar transaction_reference UK\n        timestamp payment_date\n    }\n\n    COURIERS {\n        int courier_id PK\n        varchar first_name\n        varchar last_name\n        varchar phone UK\n        boolean is_active\n    }\n\n    DELIVERIES {\n        int delivery_id PK\n        int order_id FK\n        int address_id FK\n        int courier_id FK\n        varchar delivery_status\n        varchar tracking_number UK\n        timestamp dispatched_at\n        timestamp delivered_at\n    }\n\n    DELIVERY_STATUS_HISTORY {\n        int history_id PK\n        int delivery_id FK\n        varchar status\n        timestamp status_time\n        text notes\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ChH3JrsRUze3GtDf3eTV-1">
